{
  "name": "@aigw/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/opensource-isolation.mjs dev",
    "deploy": "node ../scripts/opensource-isolation.mjs deny-remote",
    "build": "node ../scripts/prepare-config.mjs && pnpm --filter @aigw/web build",
    "build:web": "node ../scripts/prepare-config.mjs && pnpm --filter @aigw/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "node ../scripts/opensource-isolation.mjs migrate",
    "db:migrate:remote": "node ../scripts/opensource-isolation.mjs deny-remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "hono": "^4.13.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.125.0"
  }
}
